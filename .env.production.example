NODE_ENV=production
APP_MODE=staging
PUBLIC_APP_URL=https://test.example.com

API_PORT=3000
API_BASE_URL=https://test.example.com/api/v1

POSTGRES_USER=ai_arbitrage
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=ai_arbitrage
DATABASE_URL=postgresql://ai_arbitrage:replace-with-strong-postgres-password@127.0.0.1:5432/ai_arbitrage
PERSISTENCE_REQUIRED=true
APP_STATE_KEY=primary
APP_STATE_PERSIST_DEBOUNCE_MS=300

REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

ADMIN_USERNAME=replace-admin-username
ADMIN_PASSWORD=replace-admin-password
# Optional stronger mode: set ADMIN_PASSWORD_HASH and remove ADMIN_PASSWORD from the server env.
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_ROLE=super_admin
ADMIN_PERMISSIONS=admin.view,customer.edit,kyc.approve,deposit.approve,deposit.address.update,withdrawal.complete,balance.adjust,vip.update,exchange.update,audit.view
CUSTOMER_SESSION_TTL_HOURS=24
ADMIN_SESSION_TTL_HOURS=8

ENABLE_DEFAULT_ADMIN_SEED=false
ENABLE_SIMULATION_ENGINE=true
ENABLE_OPERATION_REWARD=false
ENABLE_MANUAL_BALANCE_ADJUSTMENT=true
REQUIRE_KYC_FOR_SIMULATION=true
REQUIRE_KYC_FOR_INVITE_REWARD=true
DISABLE_EXTERNAL_EXCHANGE_ORDER=true
SHOW_SIMULATION_DISCLOSURE=false

BUSINESS_TIMEZONE=Asia/Tokyo
BUSINESS_DAY_MODE=tokyo_natural_day

AUDIT_LOG_PATH=/var/log/ai-arbitrage/audit-log.jsonl
BACKUP_DIR=/var/backups/ai-arbitrage/postgres
BACKUP_RETENTION_DAYS=14

# Use one provider for production email codes.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx
EMAIL_FROM=AI Arbitrage Pro <noreply@example.com>

{
  "name": "AI Arbitrage Web",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/AI",
  "forwardPorts": [3000, 5173, 5432, 6379],
  "portsAttributes": {
    "3000": {
      "label": "API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Web",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL"
    },
    "6379": {
      "label": "Redis"
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@11.5.3 --activate && pnpm install",
  "postStartCommand": "echo 'Run pnpm dev to start API and Web.'",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Prisma.prisma"
      ]
    }
  }
}

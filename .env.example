NODE_ENV=development
APP_MODE=local
PUBLIC_APP_URL=http://127.0.0.1:3000

WEB_PORT=5173
API_PORT=3000
API_BASE_URL=http://127.0.0.1:3000/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_arbitrage
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret

DEFAULT_ADMIN_USERNAME=yuki888
DEFAULT_ADMIN_PASSWORD=123456
ADMIN_USERNAME=yuki888
ADMIN_PASSWORD=123456
# Optional: use ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD after generating a secure hash.
# ADMIN_PASSWORD_HASH=scrypt$...
ADMIN_ROLE=超级管理员
ADMIN_PERMISSIONS=admin.view,customer.edit,kyc.approve,deposit.approve,deposit.address.update,withdrawal.complete,balance.adjust,vip.update,exchange.update,audit.view
CUSTOMER_SESSION_TTL_HOURS=24
ADMIN_SESSION_TTL_HOURS=8
ENABLE_DEFAULT_ADMIN_SEED=true

ENABLE_SIMULATION_ENGINE=true
ENABLE_OPERATION_REWARD=true
ENABLE_MANUAL_BALANCE_ADJUSTMENT=true
REQUIRE_KYC_FOR_SIMULATION=true
REQUIRE_KYC_FOR_INVITE_REWARD=true
DISABLE_EXTERNAL_EXCHANGE_ORDER=true
SHOW_SIMULATION_DISCLOSURE=true

BUSINESS_TIMEZONE=Asia/Tokyo
BUSINESS_DAY_MODE=tokyo_natural_day
AUDIT_LOG_PATH=.runtime/audit-log.jsonl
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=14

# Email verification provider. Use one provider for production email codes.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx
EMAIL_FROM=AI Arbitrage Pro <noreply@example.com>
